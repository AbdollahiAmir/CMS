{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDb;Initial Catalog=sitedb;Integrated Security=True"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "ShopAPI",
    "Audience": "ShopAPI.Client",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 14,
    "RefreshTokenMaxDays": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Auth": {
    "CookieSameSite": "None"
  },
  "Site": {
    "BaseUrl": "",
    "Title": "",
    "Description": "",
    "Language": "fa",
    "PostPathTemplate": "/blog/{slug}",
    "PagePathTemplate": "/pages/{slug}",
    "ProductPathTemplate": "/products/{slug}"
  },
  "Audit": {
    "RetentionDays": 180
  }
}